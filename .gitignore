# 가상환경 / 패키지 캐시
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 데이터: DVC가 data/raw/, data/processed/ 안에 자체 .gitignore를 만들어서
# 실제 데이터 파일만 무시하고 .dvc 포인터 파일은 git이 추적하게 관리한다.
# (여기서 미리 무시해버리면 DVC가 만드는 .dvc 파일까지 가려져서 git에 안 올라감)

# MLflow 로컬 기록 (용량 크고, 실행할 때마다 새로 생김)
mlruns/

# train.py가 서빙용으로 내보내는 모델 파일 (학습 결과물, 소스 아님)
models/

# serve.py가 남기는 예측 로그 (실행 결과물, 소스 아님)
logs/

# 교재/참고자료 (프로젝트 코드 아님)
reference/

# Jupyter 체크포인트
.ipynb_checkpoints/

# OS
.DS_Store
